    "./glossary": "./src/technical-glossary.ts",
    "./normalizer": "./src/text-normalizer.ts",
    "./speaker-resolver": "./src/speaker-resolver.ts",
    "./planner": "./src/narration-planner.ts",
    "./timeline": "./src/timeline.ts",
    "./host": "./host/index.ts",
    "./storage-roots": "./host/storage-roots.ts",
    "./normalizer-process": "./host/normalizer-process.ts",
