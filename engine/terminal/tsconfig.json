{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "paths": {
      "@course-factory/lesson-compiler/ir": ["../../engine/compiler/src/ir.ts"]
    }
  },
  "include": ["src/**/*.ts", "container/**/*.ts", "tests/**/*.ts"]
}
