{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@course-factory/lesson-compiler/ir": ["../../engine/compiler/src/ir.ts"],
      "@course-factory/runtime-orchestrator": ["../../engine/runtime/src/index.ts"],
      "@course-factory/runtime-orchestrator/*": ["../../engine/runtime/src/*"]
    }
  },
  "include": ["electron/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "vite.config.ts"]
}
